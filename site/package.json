{
  "name": "tinypeek",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run lens && vite --port 4410",
    "lens": "bun run scripts/lens.ts",
    "build": "bun run lens && tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "serve": "kit serve",
    "check": "kit check --proxy /helper/=http://127.0.0.1:7420/",
    "deploy": "kit deploy",
    "unit": "kit unit"
  },
  "dependencies": {
    "@tinymachines/kit": "git+ssh://git@github.com/tinymachines/kit.git#v0.3.25",
    "marked": "^18.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@webgpu/types": "^0.1.74",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "14.0.0",
    "postcss": "^8.5.4",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
